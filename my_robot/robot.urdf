<robot name="robot">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_Base01.STL"/>
            </geometry>    
        </visual>    
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_Base01.STL"/>
            </geometry>    
        </collision>
    </link>

    <joint name="q1" type="revolute">
        <origin xyz="0 0 0.01" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="link1"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="1000" velocity="0.0"/>
    </joint>

    <link name="link1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_RPjoint.STL"/>
            </geometry>    
        </visual>    
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_RPjoint.STL"/>
            </geometry>     
        </collision>
    </link>

    <joint name="q2" type="prismatic">
        <origin xyz="0 0 0.065" rpy="0.0 0.0 0.0"/>
        <parent link="link1"/>
        <child link="link2"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.00" upper="0.470" effort="1000" velocity="0.0"/>
    </joint>

    <link name="link2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_linkkilink.STL"/>
            </geometry>    
        </visual>    
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_linkkilink.STL"/>
            </geometry>     
        </collision>
    </link>

    <joint name="q4" type="prismatic">
        <origin xyz="0 -0.05 0" rpy="1.57079632679 0 0"/>
        <parent link="link2"/>
        <child link="link3"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.0" upper="0.50" effort="1000" velocity="0.0"/>
    </joint>

    <link name="link3">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_toptangtang.STL"/>
            </geometry>    
        </visual>    
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_toptangtang.STL"/>
            </geometry>     
        </collision>
    </link>

    <joint name="q5" type="fixed">
        <origin xyz="0 0 0.155" rpy="0 0 0"/>
        <parent link="link3"/>
        <child link="End Effector"/>
    </joint>

    <link name="End Effector">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_EndEffector.STL"/>
            </geometry>    
        </visual>    
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot/meshes/Kinematic_Lab0_EndEffector.STL"/>
            </geometry>     
        </collision>
    </link>
</robot>